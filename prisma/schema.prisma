generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --------------------------------------
// ENUMS (Estados y Roles)
// --------------------------------------

enum Role {
  CLIENT
  VET
  ADMIN
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum RecordType {
  VACCINE
  DEWORMING
  CONSULTATION
  SURGERY
}

// --------------------------------------
// MODELOS / TABLAS
// --------------------------------------

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  fullName  String
  phone     String?
  role      Role     @default(CLIENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pets         Pet[]
  appointments Appointment[]
}

model Pet {
  id        String   @id @default(uuid())
  name      String
  species   String   // "Perro", "Gato", etc.
  breed     String?
  birthDate DateTime?
  weight    Float?
  photoUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  appointments   Appointment[]
  medicalRecords MedicalRecord[]
}

model Service {
  id              String   @id @default(uuid())
  name            String   // Ej: "Peluquería Completa", "Consulta General"
  description     String?
  durationMinutes Int      // Ej: 45
  price           Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  appointments Appointment[]
}

model Appointment {
  id        String            @id @default(uuid())
  dateTime  DateTime
  status    AppointmentStatus @default(PENDING)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
}

model MedicalRecord {
  id          String     @id @default(uuid())
  type        RecordType
  title       String     // Ej: "Vacuna Antirrábica", "Control Anual"
  appliedDate DateTime   @default(now())
  dueDate     DateTime?  // Fecha del próximo refuerzo
  notes       String?
  veterinarian String?   // Nombre del veterinario que la aplicó
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  petId String
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)
}